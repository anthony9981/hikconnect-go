# Hikvision device (private protocol, usually port 8000)
HIK_HOST=192.168.1.64
HIK_PORT=8000
HIK_USER=admin
HIK_PASS=changeme

# Channel number. 0 = auto-detect from device info
# (analog DVRs start at 1, NVR IP channels typically at 33).
# Note: the account must have "Remote Live View" permission
# for the channel or RealPlay fails with error code 2.
HIK_CHANNEL=0

# main | sub | third
HIK_STREAM=main

# Set to 1 for TLS transport (most devices do not support it)
# HIK_TLS=

# Bridge TCP listen address inside the container
# LISTEN_ADDR=:5000
